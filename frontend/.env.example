# ─── Frontend (React + Vite) ──────────────────────────────────
# Copy to .env (local) or set in your host (e.g. Vercel). Only VITE_* vars reach the browser.
# Never put secrets here.

# MS1 API base URL, including the /api suffix.
# Local: http://localhost:3000/api   |   Production: https://your-ms1-domain/api
VITE_API_BASE_URL=http://localhost:3000/api
