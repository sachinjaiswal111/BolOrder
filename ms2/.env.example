# ─── MS2 Voice AI Service (FastAPI) ───────────────────────────
# Copy to .env and run uvicorn from inside the ms2 folder (.env is read from the current directory).

# ─── Application ──────────────────────────────────────────────
APP_NAME=BolOrder Voice AI Service
APP_ENV=development
DEBUG=False
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ─── LLM ──────────────────────────────────────────────────────
# Supported: openai | openrouter | groq | gemini | claude (alias: anthropic)
# For claude use a model id like claude-sonnet-5-5 / claude-haiku-5-5 / claude-opus-5-5 and an Anthropic API key.
# A key starting with sk-or- is auto-detected as OpenRouter.
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
API_KEY=your_llm_api_key_here

# ─── Whisper (speech-to-text) ─────────────────────────────────
# tiny | base | small | medium | large
WHISPER_MODEL=small
DEVICE=cpu
COMPUTE_TYPE=int8

# ─── MS1 connection ───────────────────────────────────────────
MS1_BASE_URL=http://localhost:3000
MS1_TIMEOUT_SECONDS=10

# ─── Service security (REQUIRED) ──────────────────────────────
# MUST be identical to MS2_SERVICE_SECRET in ms1-core-api/.env.
# If empty, every conversation endpoint returns 500.
MS2_SERVICE_SECRET=change_me_shared_secret

# ─── TTS (currently unused by the active code path) ───────────
TTS_PROVIDER=gtts

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Session ──────────────────────────────────────────────────
SESSION_TTL_SECONDS=1800

# ─── Confidence thresholds (RapidFuzz score 0-100) ────────────
SHOP_CONFIDENCE_THRESHOLD=70
SHOP_MIN_MATCH_THRESHOLD=40
PRODUCT_CONFIDENCE_THRESHOLD=65
MAX_RETRY_COUNT=2

# ─── Monitoring (optional) ────────────────────────────────────
SENTRY_DSN=
