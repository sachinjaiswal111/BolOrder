# ─── MS1 Core API (Express) ───────────────────────────────────
# Copy to .env. Variables marked REQUIRED make the app exit on startup if missing.

# ─── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ─── Database (REQUIRED) ──────────────────────────────────────
# PostgreSQL / Supabase connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Auth (REQUIRED) ──────────────────────────────────────────
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── MS2 (AI service) connection ──────────────────────────────
FASTAPI_BASE_URL=http://localhost:8000
# Shared secret. MUST be identical to MS2_SERVICE_SECRET in ms2/.env.
# MS2 calls fail with 500/403 if this is empty or different.
MS2_SERVICE_SECRET=change_me_shared_secret

# ─── Shops ────────────────────────────────────────────────────
SHOP_CREATION_PASSCODE=

# ─── Audio upload ─────────────────────────────────────────────
UPLOAD_DIR=uploads/audio
MAX_FILE_SIZE_MB=25

# ─── AWS SES (email) ──────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=

# ─── Monitoring (optional) ────────────────────────────────────
SENTRY_DSN=
